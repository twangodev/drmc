{
  "name": "drmc",
  "version": "1.0.0",
  "description": "Cloudflare-hosted Last.fm to Discord music presence",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "bun@1.4.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "bun run dev",
    "dev": "bun run build:app && wrangler dev --ip 127.0.0.1 --port 8787",
    "build:app": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir=dist",
    "build:release": "bun run build:app && bun run build:worker && node scripts/stamp-release.ts",
    "check": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "audit:discord": "node scripts/audit-discord-api.ts",
    "build": "bun run check && bun run build:app && bun run build:worker",
    "test": "bun run build && bun run test:worker",
    "test:worker": "node --test tests/*.test.ts",
    "test:web": "playwright test",
    "deploy": "node scripts/deploy.ts",
    "check:deployment": "node scripts/check-deployment.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@number-flow/svelte": "^0.4.2",
    "@playwright/test": "^1.63.0",
    "@lucide/svelte": "^0.575.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.1",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.0",
    "bits-ui": "^2.19.5",
    "miniflare": "^5.20261001.0-alpha",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  },
  "private": true
}
